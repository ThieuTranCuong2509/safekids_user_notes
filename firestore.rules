rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Teams collection (Teamwork & RBAC)
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (resource.data.memberIds.hasAny([request.auth.uid]) || resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.memberRoles[request.auth.uid] == 'owner');
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Notes collection (Personal & Team notes)
    match /notes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.teamId != null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.teamId != null);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 4. Categories collection
    match /categories/{categoryId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // 5. Todos collection (Personal & Team checklist)
    match /todos/{todoId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.teamId != null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.teamId != null);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 6. Game Scores (Leaderboard) collection
    match /game_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 7. Activity Logs collection
    match /activity_logs/{logId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
